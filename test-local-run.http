# Requires PAYMENT_SERVICE_NAME and PAYMENT_TOKEN in the HTTP Client process environment.
### Run test locally
POST http://localhost:11234/test/run
Content-Type: application/json

{
  "serviceName": "{{$env.PAYMENT_SERVICE_NAME}}",
  "token": "{{$env.PAYMENT_TOKEN}}",
  "ratePerSecond": 2,
  "testCount": 500,
  "processingTimeMillis": 60000,
  "testSuccessByThePaymentFact": false
}

### Stop running test to save time and resources
# @timeout 120
POST http://localhost:11234/test/stop/{{$env.PAYMENT_SERVICE_NAME}}
