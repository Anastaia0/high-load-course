{
  "uid": "case-3-payments",
  "title": "Case 3 — поток оплат",
  "tags": ["case-3", "payments"],
  "timezone": "Europe/Moscow",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-20m", "to": "now"},
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service", "label": "Сервис", "type": "query", "refresh": 1,
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "query": "label_values(shop_payment_received_total, service)",
        "includeAll": false, "multi": false, "options": []
      },
      {
        "name": "shop_job", "label": "Источник магазина", "type": "query", "refresh": 1,
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "query": "label_values(shop_payment_received_total{service=\"$service\"}, job)",
        "includeAll": false, "multi": false, "options": []
      },
      {
        "name": "provider_job", "label": "Источник Bombardier", "type": "query", "refresh": 1,
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "query": "label_values(up{job=~\".*bombardier.*\"}, job)",
        "includeAll": false, "multi": false, "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Поступление, отправка и завершение оплат / с", "type": "timeseries",
      "description": "Собственные Counter магазина. Счётчик отправок увеличивается после разрешений семафора и rate limiter, непосредственно перед HTTP-вызовом.",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(rate(shop_payment_received_total{service=\"$service\",job=\"$shop_job\"}[$__rate_interval]))", "legendFormat": "Поступили"},
        {"refId": "B", "expr": "sum(rate(shop_payment_submitted_total{service=\"$service\",job=\"$shop_job\",account=\"acc-5\"}[$__rate_interval]))", "legendFormat": "Отправлены провайдеру"},
        {"refId": "C", "expr": "sum(rate(shop_payment_completed_total{service=\"$service\",job=\"$shop_job\",account=\"acc-5\"}[$__rate_interval]))", "legendFormat": "Завершены в магазине"}
      ],
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}}
    },
    {
      "id": 2, "title": "Принятые оплаты без результата", "type": "timeseries",
      "description": "received − completed: суммарно очередь и выполняемые оплаты. Формула относится к одному магазину, одному аккаунту и одному жизненному циклу процесса.",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "clamp_min(sum(shop_payment_received_total{service=\"$service\",job=\"$shop_job\"}) - sum(shop_payment_completed_total{service=\"$service\",job=\"$shop_job\",account=\"acc-5\"}), 0)", "legendFormat": "Ожидают / выполняются"}]
    },
    {
      "id": 3, "title": "Результат обработки в магазине / с", "type": "timeseries",
      "description": "Успешная обработка провайдером не гарантирует, что покупатель дождался её до дедлайна. Для этого сравнивайте с результатами Bombardier справа.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (result) (rate(shop_payment_completed_total{service=\"$service\",job=\"$shop_job\",account=\"acc-5\"}[$__rate_interval]))", "legendFormat": "{{result}}"}]
    },
    {
      "id": 4, "title": "Результат покупки по Bombardier / с", "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (testOutcome) (rate(test_duration_count{service=\"$service\",job=\"$provider_job\"}[$__rate_interval]))", "legendFormat": "{{testOutcome}}"}]
    },
    {
      "id": 5, "title": "Счётчики магазина с момента запуска процесса", "type": "stat",
      "description": "Для точных итогов отдельного прогона скрипт сохраняет значения до и после, затем считает разницу. Эти числа не ограничены выбранным диапазоном времени.",
      "gridPos": {"h": 5, "w": 16, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(shop_payment_received_total{service=\"$service\",job=\"$shop_job\"})", "instant": true, "legendFormat": "Принято"},
        {"refId": "B", "expr": "sum(shop_payment_submitted_total{service=\"$service\",job=\"$shop_job\",account=\"acc-5\"})", "instant": true, "legendFormat": "Отправлено"},
        {"refId": "C", "expr": "sum(shop_payment_completed_total{service=\"$service\",job=\"$shop_job\",account=\"acc-5\"})", "instant": true, "legendFormat": "Завершено"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"}
    },
    {
      "id": 6, "title": "Сбор метрик: 1 — доступен", "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 18},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "min(up{job=\"$shop_job\"})", "instant": true, "legendFormat": "Магазин"},
        {"refId": "B", "expr": "min(up{job=\"$provider_job\"})", "instant": true, "legendFormat": "Bombardier"}
      ],
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"}
    }
  ]
}
